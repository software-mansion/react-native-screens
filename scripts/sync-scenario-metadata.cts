#!/usr/bin/env node
//
// sync-scenario-metadata.cts
//
// Generates the metadata block of every scenario.md from the
// scenario-description.ts in the same directory. scenario-description.ts is the
// single source of truth for platforms, devices, OS versions, device setup and
// E2E coverage; scenario.md only holds the generated block, the Description,
// the Note and the Steps.
//
// The block is placed between SCENARIO_METADATA_START and SCENARIO_METADATA_END
// markers. If a scenario.md has no block yet, it is inserted below the title.
//
// Usage:
//   node scripts/sync-scenario-metadata.cts           # write blocks
//   node scripts/sync-scenario-metadata.cts --check   # fail if any block is outdated (CI)

// Node's strip-only TypeScript support erases types without rewriting syntax, so
// this CommonJS script must use `require` rather than `import`/`import =`.
const fs = require('node:fs') as typeof import('node:fs');
const path = require('node:path') as typeof import('node:path');
const vm = require('node:vm') as typeof import('node:vm');
const ts = require('typescript') as typeof import('typescript');

type ScenarioDevice =
  | 'iphone'
  | 'ipad'
  | 'iphone-duo'
  | 'android-phone'
  | 'android-tablet';

// Mirrors ScenarioDescription from apps/src/tests/shared/helpers.ts.
interface ScenarioDescription {
  name: string;
  key: string;
  details?: string;
  platforms?: ('android' | 'ios')[];
  devices?: ScenarioDevice[];
  osVersions?: Partial<
    Record<ScenarioDevice, { createdOn: string[]; testOn: string[] }>
  >;
  deviceSetup?: Partial<Record<ScenarioDevice, string>>;
  e2eCoverage: 'full' | 'incomplete' | 'tbd';
  e2eCoverageDetails?: string;
  smokeTest: boolean;
}

const SCENARIO_METADATA_START =
  '<!-- scenario-metadata:start: generated by `yarn sync-scenario-metadata` -->';
const SCENARIO_METADATA_END = '<!-- scenario-metadata:end -->';
const START_MARKER_PREFIX = '<!-- scenario-metadata:start';

const DEVICE_LABELS: Record<ScenarioDevice, string> = {
  iphone: 'iPhone',
  ipad: 'iPad',
  'iphone-duo': 'iPhone Duo',
  'android-phone': 'Android phone',
  'android-tablet': 'Android tablet',
};

const DEVICE_PLATFORMS: Record<ScenarioDevice, 'ios' | 'android'> = {
  iphone: 'ios',
  ipad: 'ios',
  'iphone-duo': 'ios',
  'android-phone': 'android',
  'android-tablet': 'android',
};

const PLATFORM_LABELS = { ios: 'iOS', android: 'Android' } as const;

const E2E_COVERAGE_LABELS = {
  full: 'Full',
  incomplete: 'Incomplete',
  tbd: 'TBD',
} as const;

// Sections whose content now lives in scenario-description.ts.
const FORBIDDEN_MANUAL_CONTENT: { pattern: RegExp; field: string }[] = [
  { pattern: /^## Details\s*$/m, field: 'osVersions' },
  { pattern: /^## E2E test\s*$/m, field: 'e2eCoverage / e2eCoverageDetails' },
  { pattern: /^## Prerequisites\s*$/m, field: 'devices / deviceSetup' },
  { pattern: /\*\*OS test creation version:\*\*/, field: 'osVersions' },
];

const repoRoot = path.resolve(__dirname, '..');
const testsRoot = path.join(repoRoot, 'apps', 'src', 'tests');

function findScenarioDirs(dir: string): string[] {
  const result: string[] = [];
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    if (!entry.isDirectory()) {
      continue;
    }
    const entryPath = path.join(dir, entry.name);
    if (fs.existsSync(path.join(entryPath, 'scenario-description.ts'))) {
      result.push(entryPath);
    }
    result.push(...findScenarioDirs(entryPath));
  }
  return result;
}

function loadScenarioDescription(file: string): ScenarioDescription {
  const source = fs.readFileSync(file, 'utf8');
  const { outputText } = ts.transpileModule(source, {
    compilerOptions: { module: ts.ModuleKind.CommonJS },
    fileName: file,
  });
  const moduleExports: { scenarioDescription?: ScenarioDescription } = {};
  vm.runInNewContext(outputText, {
    exports: moduleExports,
    require: (id: string) => {
      throw new Error(
        `scenario-description.ts must only use type imports, got runtime import of '${id}'`,
      );
    },
  });
  if (!moduleExports.scenarioDescription) {
    throw new Error('missing `export const scenarioDescription`');
  }
  return moduleExports.scenarioDescription;
}

function validate(description: ScenarioDescription): string[] {
  const errors: string[] = [];
  const { devices, platforms, osVersions, deviceSetup } = description;

  if (!Array.isArray(devices) || devices.length === 0) {
    errors.push('`devices` must list at least one device');
    return errors;
  }
  for (const device of devices) {
    if (!(device in DEVICE_LABELS)) {
      errors.push(`unknown device '${device}'`);
    } else if (platforms && !platforms.includes(DEVICE_PLATFORMS[device])) {
      errors.push(
        `device '${device}' requires platform '${DEVICE_PLATFORMS[device]}' in \`platforms\``,
      );
    }
  }
  for (const [field, record] of [
    ['osVersions', osVersions],
    ['deviceSetup', deviceSetup],
  ] as const) {
    for (const device of Object.keys(record ?? {})) {
      if (!devices.includes(device as ScenarioDevice)) {
        errors.push(`\`${field}\` has '${device}' which is not in \`devices\``);
      }
    }
  }
  return errors;
}

function oneLine(text: string): string {
  return text.replace(/\s+/g, ' ').trim();
}

function renderMetadata(description: ScenarioDescription): string {
  const { osVersions, deviceSetup } = description;
  const devices = description.devices ?? [];
  const platforms = description.platforms
    ?.map(platform => PLATFORM_LABELS[platform])
    .join(', ');

  const lines = [
    SCENARIO_METADATA_START,
    '',
    '| Field | Value |',
    '| ----- | ----- |',
    `| Key | \`${description.key}\` |`,
    `| Platforms | ${platforms ?? '-'} |`,
    `| E2E coverage | ${E2E_COVERAGE_LABELS[description.e2eCoverage]} |`,
    `| Smoke test | ${description.smokeTest ? 'Yes' : 'No'} |`,
    '',
  ];

  // One row per device; the Setup column only when some device needs setup.
  const hasSetup = devices.some(device => deviceSetup?.[device]);
  lines.push(
    hasSetup ? '| Device | Test on | Setup |' : '| Device | Test on |',
    hasSetup ? '| ------ | ------- | ----- |' : '| ------ | ------- |',
  );
  for (const device of devices) {
    const cells = [
      DEVICE_LABELS[device],
      osVersions?.[device]?.testOn.join(', ') || 'not recorded',
    ];
    if (hasSetup) {
      const setup = deviceSetup?.[device];
      cells.push(setup ? oneLine(setup).replace(/\|/g, '\\|') : '-');
    }
    lines.push(`| ${cells.join(' | ')} |`);
  }
  lines.push('');

  if (description.e2eCoverageDetails) {
    lines.push(
      `**E2E coverage details:** ${oneLine(description.e2eCoverageDetails)}`,
      '',
    );
  }

  lines.push(SCENARIO_METADATA_END);
  return lines.join('\n');
}

// Returns scenario.md content with the metadata block replaced or inserted.
function applyMetadata(markdown: string, block: string): string {
  const start = markdown.indexOf(START_MARKER_PREFIX);
  const end = markdown.indexOf(SCENARIO_METADATA_END);

  if (start !== -1 && end !== -1 && end > start) {
    return (
      markdown.slice(0, start) +
      block +
      markdown.slice(end + SCENARIO_METADATA_END.length)
    );
  }

  // No block yet: insert it right below the `# Test Scenario: ...` title.
  const titleMatch = /^# .*$/m.exec(markdown);
  if (!titleMatch) {
    return `${block}\n\n${markdown}`;
  }
  const titleEnd = titleMatch.index + titleMatch[0].length;
  return `${markdown.slice(0, titleEnd)}\n\n${block}${markdown.slice(
    titleEnd,
  )}`;
}

function main(): void {
  const args = process.argv.slice(2);
  const check = args.includes('--check');

  const problems: string[] = [];
  let updated = 0;

  for (const dir of findScenarioDirs(testsRoot)) {
    const relativeDir = path.relative(repoRoot, dir);
    const scenarioPath = path.join(dir, 'scenario.md');
    if (!fs.existsSync(scenarioPath)) {
      continue;
    }

    let description: ScenarioDescription;
    try {
      description = loadScenarioDescription(
        path.join(dir, 'scenario-description.ts'),
      );
    } catch (error) {
      problems.push(
        `${relativeDir}/scenario-description.ts: ${(error as Error).message}`,
      );
      continue;
    }

    // Scenarios without `devices` are not migrated yet; leave them alone in
    // write mode, but keep --check strict.
    if (!check && description.devices === undefined) {
      continue;
    }

    const errors = validate(description);
    if (errors.length > 0) {
      for (const error of errors) {
        problems.push(`${relativeDir}/scenario-description.ts: ${error}`);
      }
      continue;
    }

    const markdown = fs.readFileSync(scenarioPath, 'utf8');
    const expected = applyMetadata(markdown, renderMetadata(description));

    const expectedWithoutBlock = expected.replace(
      /<!-- scenario-metadata:start[\s\S]*?<!-- scenario-metadata:end -->/,
      '',
    );
    for (const { pattern, field } of FORBIDDEN_MANUAL_CONTENT) {
      if (pattern.test(expectedWithoutBlock)) {
        problems.push(
          `${relativeDir}/scenario.md: '${pattern.source}' must not be written by hand, move it to \`${field}\` in scenario-description.ts`,
        );
      }
    }

    if (expected === markdown) {
      continue;
    }
    if (check) {
      problems.push(
        `${relativeDir}/scenario.md: metadata block is missing or outdated`,
      );
    } else {
      fs.writeFileSync(scenarioPath, expected);
      updated += 1;
    }
  }

  if (!check) {
    console.log(`Updated metadata in ${updated} scenario.md file(s).`);
  }
  if (problems.length > 0) {
    console.error(problems.join('\n'));
    if (check) {
      console.error(
        '\nRun `yarn sync-scenario-metadata` to regenerate the metadata blocks.',
      );
    }
    process.exit(1);
  }
}

// Writes the metadata block of <dir>/scenario.md from <dir>/scenario-description.ts.
function writeScenarioMetadata(dir: string): void {
  const scenarioPath = path.join(dir, 'scenario.md');
  const description = loadScenarioDescription(
    path.join(dir, 'scenario-description.ts'),
  );
  fs.writeFileSync(
    scenarioPath,
    applyMetadata(
      fs.readFileSync(scenarioPath, 'utf8'),
      renderMetadata(description),
    ),
  );
}

module.exports = { writeScenarioMetadata };

if (require.main === module) {
  main();
}
