# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

require_relative '../../scripts/ios/rns_update_info_plist'
require_relative '../../scripts/ios/rns_set_swift_compilation_flags'

# Apple deprecated the UIApplicationDelegate app lifecycle in iOS 26 / tvOS 26, so the
# UIScene lifecycle is the default here. Set RNS_USE_SCENE_DELEGATE=0 to build the legacy
# AppDelegate path (useful for reproducing issues from apps that have not adopted scenes).
def rns_scene_delegate_enabled?
  !%w[0 false].include?(ENV['RNS_USE_SCENE_DELEGATE'].to_s.strip.downcase)
end

platform :tvos, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'TVOSExample' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    project_path = File.join(__dir__, 'TVOSExample.xcodeproj')
    info_plist_path = File.join(__dir__, 'TVOSExample', 'Info.plist')

    if rns_scene_delegate_enabled?
      # tvOS only ever has a single window scene, unlike iPadOS.
      rns_add_scene_manifest_to_info_plist(
        info_plist_path: info_plist_path,
        supports_multiple_scenes: false
      )
      rns_set_swift_active_compilation_flag(
        project_path: project_path,
        flag: 'RNS_USE_SCENE_DELEGATE'
      )
    else
      rns_remove_scene_manifest_from_info_plist(
        info_plist_path: info_plist_path
      )
      rns_unset_swift_active_compilation_flag(
        project_path: project_path,
        flag: 'RNS_USE_SCENE_DELEGATE'
      )
    end
  end
end
